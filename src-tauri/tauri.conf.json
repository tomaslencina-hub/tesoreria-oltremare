{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tesoreria Oltremare",
  "version": "../package.json",
  "identifier": "com.oltremare.tesoreria",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tesorería Oltremare",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMkJFOTEzQzA1NUI1QjYKUldTMnRWWEFFK2tyYm0zbGp6b2RMRll6Z0RobXBYWEhLTUZZN3pHaHlJWW0zUlJFUlBQbENiUloK",
      "endpoints": [
        "https://github.com/tomaslencina-hub/tesoreria-oltremare/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
